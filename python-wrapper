TEXT='  $$\ $$\   $$$$$$$\ $$\     $$\ $$$$$$$$\ $$\   $$\  $$$$$$\  $$\   $$\ 
  $$ \$$ \  $$  __$$\\$$\   $$  |\__$$  __|$$ |  $$ |$$  __$$\ $$$\  $$ |
$$$$$$$$$$\ $$ |  $$ |\$$\ $$  /    $$ |   $$ |  $$ |$$ /  $$ |$$$$\ $$ |
\_$$  $$   |$$$$$$$  | \$$$$  /     $$ |   $$$$$$$$ |$$ |  $$ |$$ $$\$$ |
$$$$$$$$$$\ $$  ____/   \$$  /      $$ |   $$  __$$ |$$ |  $$ |$$ \$$$$ |
\_$$  $$  _|$$ |         $$ |       $$ |   $$ |  $$ |$$ |  $$ |$$ |\$$$ |
  $$ |$$ |  $$ |         $$ |       $$ |   $$ |  $$ | $$$$$$  |$$ | \$$ |
  \__|\__|  \__|         \__|       \__|   \__|  \__| \______/ \__|  \__|
                                                                         
                                                                         
                                                                         
 $$$$$$\   $$$$$$\  $$$$$$$\  $$$$$$\ $$$$$$$\ $$$$$$$$\           
$$  __$$\ $$  __$$\ $$  __$$\ \_$$  _|$$  __$$\\__$$  __|          
$$ /  \__|$$ /  \__|$$ |  $$ |  $$ |  $$ |  $$ |  $$ |         $$\ 
\$$$$$$\  $$ |      $$$$$$$  |  $$ |  $$$$$$$  |  $$ |         \__|
 \____$$\ $$ |      $$  __$$<   $$ |  $$  ____/   $$ |             
$$\   $$ |$$ |  $$\ $$ |  $$ |  $$ |  $$ |        $$ |         $$\ 
\$$$$$$  |\$$$$$$  |$$ |  $$ |$$$$$$\ $$ |        $$ |         \__|
 \______/  \______/ \__|  \__|\______|\__|        \__|             
                                                                   
                                                                   
                                                                   
'

TOTAL=$(printf '%s\n' "$TEXT" | wc -l)
LINE=0

while IFS= read -r text; do

    if [ "$TOTAL" -gt 1 ]; then
        T=$(awk "BEGIN {print $LINE/($TOTAL-1)}")
    else
        T=0
    fi

    # Cyan -> Azul -> Gris
    if (( $(awk "BEGIN {print ($T < 0.5)}") )); then
        # Cyan (0,255,255) -> Azul (30,100,255)
        X=$(awk "BEGIN {print $T*2}")
        R=$(awk "BEGIN {printf \"%.0f\", 0 + 30*$X}")
        G=$(awk "BEGIN {printf \"%.0f\", 255 - 155*$X}")
        B=255
    else
        # Azul -> Gris
        X=$(awk "BEGIN {print ($T-0.5)*2}")
        R=$(awk "BEGIN {printf \"%.0f\", 30 + 100*$X}")
        G=$(awk "BEGIN {printf \"%.0f\", 100 + 100*$X}")
        B=$(awk "BEGIN {printf \"%.0f\", 255 - 100*$X}")
    fi

    printf "\033[38;2;%s;%s;%sm%s\033[0m\n" "$R" "$G" "$B" "$text"

    LINE=$((LINE + 1))

done <<< "$TEXT"

printf '\033[38;2;255;210;0mBy: Adrenalin Team\033[0m\n'

# Ejecutar el Python real
exec /data/data/com.termux/files/usr/bin/python "$@"


